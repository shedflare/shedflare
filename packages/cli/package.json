{
  "name": "shedflare",
  "version": "0.0.0",
  "private": false,
  "description": "Set up and deploy a self-hosted Shedflare app suite to your Cloudflare account.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shedflare/shedflare.git",
    "directory": "packages/cli"
  },
  "bin": {
    "shedflare": "./dist/index.mjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core/*": {
      "import": "./dist/core/*.js",
      "types": "./dist/core/*.d.ts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check src vite.config.ts",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test"
  },
  "dependencies": {
    "@clack/prompts": "^1.2",
    "@shedflare/alchemy": "workspace:*",
    "@shedflare/auth-client": "workspace:*",
    "@shedflare/core": "workspace:*",
    "cac": "^7",
    "nano-spawn": "^2.1",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
