{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "configVersion": {
      "const": 2
    },
    "domain": {
      "type": "string",
      "pattern": "^(?!https?:\\/\\/)[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "ownerEmail": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "apps": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "subdomain": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          },
          "vars": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "productionAliases": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^(?!prod$|e2e[-_])[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "configVersion",
    "domain",
    "ownerEmail",
    "apps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shedflare.dev/schemas/shedflare-config.schema.json",
  "title": "Shedflare config version 2"
}
