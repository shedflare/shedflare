{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "beta",
        "experimental"
      ],
      "type": "string"
    },
    "category": {
      "enum": [
        "platform",
        "productivity",
        "files",
        "finance",
        "knowledge",
        "media",
        "developer"
      ],
      "type": "string"
    },
    "dataSensitivity": {
      "enum": [
        "low",
        "personal",
        "high"
      ],
      "type": "string"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "defaultSubdomain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "vars": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "from": {
            "enum": [
              "url",
              "appUrl",
              "ownerEmail",
              "user",
              "appId",
              "computed"
            ],
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "app": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "default": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "source": {
            "enum": [
              "operator",
              "generated"
            ],
            "type": "string",
            "default": "operator"
          }
        },
        "required": [
          "description",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "service"
              },
              "binding": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "app": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            },
            "required": [
              "type",
              "binding",
              "app"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "kv"
              },
              "binding": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "idField": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "required": [
              "type",
              "binding"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "d1"
              },
              "binding": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "idField": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "required": [
              "type",
              "binding"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "r2"
              },
              "binding": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "idField": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "required": [
              "type",
              "binding"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "durable_object"
              },
              "binding": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "idField": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "required": [
              "type",
              "binding"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "browser"
              },
              "binding": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "manualEnable": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "binding"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "lifecycle",
    "category",
    "dataSensitivity",
    "defaultSubdomain"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shedflare.dev/schemas/app-manifest.schema.json",
  "title": "Shedflare app manifest"
}
