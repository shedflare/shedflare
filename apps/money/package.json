{
  "name": "@shedflare/money",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted envelope-budgeting personal finance app for Cloudflare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shedflare/shedflare.git",
    "directory": "apps/money"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "dev:demo": "vp exec jiti dev-demo.ts",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "check": "vp check src build dev-demo.ts alchemy.run.ts vite.config.ts worker-configuration.d.ts drizzle.config.ts e2e.run.ts playwright.config.ts",
    "typecheck": "vp check --no-fmt --no-lint",
    "plan": "vp build && pnpm --dir ../.. exec alchemy plan apps/money/alchemy.run.ts",
    "deploy": "pnpm --dir ../.. deploy:money",
    "deploy:stage": "vp build && pnpm --dir ../.. exec alchemy deploy apps/money/alchemy.run.ts --yes",
    "destroy": "pnpm --dir ../.. destroy:money",
    "destroy:stage": "pnpm --dir ../.. exec alchemy destroy apps/money/alchemy.run.ts --yes",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "vp exec jiti e2e.run.ts",
    "lint": "vp lint . --max-warnings=0"
  },
  "dependencies": {
    "@effect/sql-d1": "catalog:",
    "@shedflare/alchemy": "workspace:*",
    "@shedflare/auth-client": "workspace:*",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@tanstack/solid-form": "catalog:",
    "@tanstack/solid-hotkeys": "catalog:",
    "d3": "^7.9.0",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "peculiar-charts": "catalog:",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.60.0",
    "@shedflare/auth": "workspace:*",
    "@shedflare/test-utils": "workspace:*",
    "@types/d3": "^7.4.3",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "jsonc-parser": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "cloudflare": {
    "bindings": {
      "APP_PUBLIC_URL": {
        "description": "The canonical public URL of the app."
      },
      "OWNER_EMAIL": {
        "description": "Required owner email."
      },
      "AUTH_URL": {
        "description": "Canonical public URL of the central Shedflare Auth login page."
      },
      "AUTH_CLIENT_ID": {
        "description": "OAuth client ID used by this app."
      },
      "DEV_AUTH_EMAIL": {
        "description": "Optional local-only development identity used on localhost."
      }
    }
  }
}
