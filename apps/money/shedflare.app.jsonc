{
  "$schema": "https://shedflare.dev/schemas/app-manifest.schema.json",
  "id": "money",
  "name": "Shedflare Money",
  "description": "Envelope-budgeting personal finance app",
  "lifecycle": "beta",
  "category": "finance",
  "dataSensitivity": "high",
  "dependsOn": ["auth"],
  "defaultSubdomain": "money",
  "vars": {
    "APP_PUBLIC_URL": {
      "from": "appUrl",
      "description": "Public URL of this money app",
    },
    "AUTH_URL": {
      "from": "appUrl",
      "app": "auth",
      "description": "Auth browser login URL",
    },
    "AUTH_CLIENT_ID": {
      "from": "appId",
      "description": "Session client ID for this app",
    },
    "OWNER_EMAIL": {
      "from": "ownerEmail",
      "description": "Deployment owner email",
    },
  },
  "secrets": {},
  "resources": [
    { "type": "service", "binding": "AUTH", "app": "auth" },
    {
      "type": "d1",
      "binding": "MONEY_DB",
    },
    {
      "type": "r2",
      "binding": "UPLOADS",
      "name": "shedflare-money-uploads",
    },
  ],
}
