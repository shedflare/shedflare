{
  "$schema": "https://shedflare.dev/schemas/app-manifest.schema.json",
  "id": "cf-bill",
  "name": "Shedflare CF Usage",
  "description": "Cloudflare estimated usage vs plan limits dashboard",
  "lifecycle": "experimental",
  "category": "developer",
  "dataSensitivity": "high",
  "dependsOn": ["auth"],
  "defaultSubdomain": "cf-bill",
  "vars": {
    "APP_PUBLIC_URL": {
      "from": "appUrl",
      "description": "Public URL of this app",
    },
    "AUTH_URL": {
      "from": "appUrl",
      "app": "auth",
      "description": "Auth browser login URL",
    },
    "AUTH_CLIENT_ID": {
      "from": "appId",
      "description": "Session client ID for this app",
    },
    "OWNER_EMAIL": {
      "from": "ownerEmail",
      "description": "Deployment owner email",
    },
    "CLOUDFLARE_ACCOUNT_ID": {
      "from": "user",
      "description": "Cloudflare account ID (from dashboard URL)",
    },
    "CLOUDFLARE_ZONE_ID": {
      "from": "user",
      "description": "Cloudflare zone ID for HTTP analytics (optional)",
    },
  },
  "secrets": {
    "CF_API_TOKEN": {
      "description": "API token with Account Analytics: Read permission",
      "required": true,
    },
  },
  "resources": [{ "type": "service", "binding": "AUTH", "app": "auth" }],
}
