{
  "name": "@shedflare/drive",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted file manager backed by Cloudflare R2 and D1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shedflare/shedflare.git",
    "directory": "apps/drive"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:live": "pnpm --dir ../.. test:drive",
    "test:e2e": "vp exec jiti e2e.run.ts",
    "check": "vp check src build alchemy.run.ts alchemy.test.ts e2e.run.ts vite.config.ts playwright.config.ts drizzle.config.ts",
    "typecheck": "vp check --no-fmt --no-lint",
    "plan": "vp build && pnpm --dir ../.. exec alchemy plan apps/drive/alchemy.run.ts",
    "deploy": "pnpm --dir ../.. deploy:drive",
    "deploy:stage": "vp build && pnpm --dir ../.. exec alchemy deploy apps/drive/alchemy.run.ts --yes",
    "destroy": "pnpm --dir ../.. destroy:drive",
    "destroy:stage": "pnpm --dir ../.. exec alchemy destroy apps/drive/alchemy.run.ts --yes",
    "db:generate": "vp exec drizzle-kit generate",
    "lint": "vp lint . --max-warnings=0"
  },
  "dependencies": {
    "@shedflare/alchemy": "workspace:*",
    "@shedflare/auth-client": "workspace:*",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "solid-js": "^1.9.12",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.60.0",
    "@shedflare/auth": "workspace:*",
    "@shedflare/test-utils": "workspace:*",
    "@solidjs/testing-library": "^0.8.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "jsonc-parser": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "cloudflare": {
    "bindings": {
      "APP_PUBLIC_URL": {
        "description": "The canonical public URL of the app."
      },
      "OWNER_EMAIL": {
        "description": "Deployment owner email."
      },
      "AUTH_URL": {
        "description": "Canonical public URL of Shedflare Auth."
      },
      "AUTH_CLIENT_ID": {
        "description": "OAuth client ID used by this app."
      },
      "DEV_AUTH_EMAIL": {
        "description": "Optional local-only development identity used on localhost."
      }
    }
  }
}
