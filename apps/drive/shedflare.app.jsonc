{
  "$schema": "https://shedflare.dev/schemas/app-manifest.schema.json",
  "id": "drive",
  "name": "Shedflare Drive",
  "description": "File storage and management",
  "lifecycle": "beta",
  "category": "files",
  "dataSensitivity": "high",
  "dependsOn": ["auth"],
  "defaultSubdomain": "drive",
  "vars": {
    "APP_PUBLIC_URL": {
      "from": "appUrl",
      "description": "Public URL of this drive app",
    },
    "AUTH_URL": {
      "from": "appUrl",
      "app": "auth",
      "description": "Auth browser login URL",
    },
    "AUTH_CLIENT_ID": {
      "from": "appId",
      "description": "Session client ID for this app",
    },
    "OWNER_EMAIL": {
      "from": "ownerEmail",
      "description": "Deployment owner email",
    },
  },
  "secrets": {
    "SECURE_UPLOAD_TOKEN_SECRET": {
      "description": "Generated secret for signing short-lived upload capabilities",
      "required": true,
      "source": "generated",
    },
  },
  "resources": [
    { "type": "service", "binding": "AUTH", "app": "auth" },
    {
      "type": "d1",
      "binding": "DB",
      "name": "shedflare-drive",
      "idField": "DB_ID",
    },
    {
      "type": "r2",
      "binding": "FILES",
      "name": "shedflare-drive-files",
    },
  ],
}
