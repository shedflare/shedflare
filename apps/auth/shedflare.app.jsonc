{
  "$schema": "https://shedflare.dev/schemas/app-manifest.schema.json",
  "id": "auth",
  "name": "Shedflare Auth",
  "description": "OpenAuth owner sign-in with opaque sessions and Worker RPC",
  "lifecycle": "beta",
  "category": "platform",
  "dataSensitivity": "high",
  "dependsOn": [],
  "defaultSubdomain": "auth",
  "vars": {
    "APP_PUBLIC_URL": {
      "from": "appUrl",
      "description": "Public URL of this auth app",
    },
    "GOOGLE_CLIENT_ID": {
      "from": "user",
      "description": "Google OAuth client ID",
    },
    "CLOUDFLARE_ACCOUNT_ID": {
      "from": "user",
      "default": "",
      "description": "Optional Cloudflare account ID for read-only agent deployment inspection",
    },
    "ADDITIONAL_ALLOWED_CLIENTS": {
      "from": "user",
      "default": "{}",
      "description": "JSON map of Shedflare client IDs to additional canonical HTTPS origins, including independently deployed apps",
    },
    "OWNER_EMAIL": {
      "from": "ownerEmail",
      "description": "Deployment owner email",
    },
    "ALLOWED_CLIENTS": {
      "from": "computed",
      "description": "JSON map of allowed client IDs to their redirect URI origins (built by Alchemy stack)",
    },
  },
  "secrets": {
    "DEPLOYMENTS_CF_API_TOKEN": {
      "description": "Optional Cloudflare API token restricted to Workers: Metadata Read-only for deployment inspection",
      "required": false,
    },
  },
  "resources": [
    {
      "type": "kv",
      "binding": "OPENAUTH_STORAGE",
      "name": "shedflare-auth-storage",
      "idField": "OPENAUTH_STORAGE_ID",
    },
    {
      "type": "d1",
      "binding": "AUTH_DB",
      "name": "shedflare-auth-db",
      "idField": "AUTH_DB_ID",
    },
  ],
}
